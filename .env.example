# External LLM Provider API Keys (Loaded strictly from environment variables)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://gateway_user:gateway_pass@postgres:5432/gateway_db
ASYNC_DATABASE_URL=postgresql+asyncpg://gateway_user:gateway_pass@postgres:5432/gateway_db

# Redis Configuration (Vector Cache with RediSearch)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_INDEX_NAME=idx:prompt_embeddings

# Application Gateway Settings
CONFIG_PATH=config.yaml
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
